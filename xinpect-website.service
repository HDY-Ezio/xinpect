[Unit]
Description=Xinpect Website - 煋鉴官网Flask服务
After=network.target nginx.service

[Service]
Type=simple
User=xinpect-web
WorkingDirectory=/opt/xinpect-website
EnvironmentFile=/etc/xinpect/website.env
ExecStartPre=/bin/bash -c 'if lsof -i :8621 > /dev/null; then kill -9 $(lsof -t -i :8621); fi'
ExecStart=/usr/bin/python3 /opt/xinpect-website/app.py
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xinpect-website
LimitNOFILE=65536
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
