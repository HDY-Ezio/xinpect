    "rules": [
        {
            "id": "CQ-CMX-001",
            "name": "圈复杂度过高",
            "severity": "critical",
            "category": "complexity",
            "description": "函数/方法的圈复杂度（Cyclomatic Complexity）超过阈值（默认30），表示代码中存在过多的分支路径，难以测试和理解。",
            "suggestion": "将复杂函数拆分为多个小的、职责单一的子函数，减少if/else/switch/if-else链式结构，使用早返回（early return）模式降低嵌套。",
            "applicable_files": [
                "*.py",
                "*.js",
                "*.ts",
                "*.java",
                "*.cs",
                "*.go",
                "*.rb",
                "*.php",
                "*.cpp",
                "*.c"
            ],
            "pattern": ""
        },
        {
            "id": "CQ-CMX-002",
            "name": "认知复杂度过高",
            "severity": "critical",
            "category": "complexity",
            "description": "函数的认知复杂度（Cognitive Complexity）超过25。认知复杂度衡量代码对人类理解的非线性增长，比圈复杂度更能反映代码的可读性问题。",
            "suggestion": "重构函数，将嵌套逻辑提取为独立函数，减少逻辑与(&&)和逻辑或(||)的链式使用，使用卫语句(guard clause)替代嵌套。",
            "applicable_files": [
                "*.py",
                "*.js",
                "*.ts",
                "*.java",
                "*.cs",
                "*.go",
                "*.rb",
                "*.php",
                "*.cpp",
                "*.c"
            ],
            "pattern": ""
        },
        {
            "id": "CQ-CMX-003",
            "name": "函数行数过多",
            "severity": "high",
            "category": "complexity",
            "description": "单个函数/方法体超过80行（不含空行和注释），函数职责可能过多。",
            "suggestion": "将函数按职责拆分为多个小函数，每个函数只做一件事，函数名应能准确描述其功能。",
            "applicable_files": [
                "*.py",
                "*.js",
                "*.ts",
