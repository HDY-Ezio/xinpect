{
  "version": "1.0.0",
  "description": "煋鉴代码质检框架 - 误报白名单配置",
  "updated": "2026-08-02",
  "skip_paths": [
    "node_modules/",
    "vendor/",
    "venv/",
    ".venv/",
    "env/",
    ".env/",
    "__pycache__/",
    ".git/",
    ".svn/",
    ".hg/",
    "dist/",
    "build/",
    "out/",
    "target/",
    ".next/",
    ".nuxt/",
    "coverage/",
    ".nyc_output/",
    "third_party/",
    "third-party/",
    "externals/",
    "bower_components/",
    "jspm_packages/",
    ".cache/",
    "tmp/",
    "temp/"
  ],
  "skip_file_patterns": [
    "*.min.js",
    "*.min.css",
    "*.bundle.js",
    "*.bundle.css",
    "*.generated.*",
    "*.auto-generated.*",
    "*.lock",
    "package-lock.json",
    "yarn.lock",
    "pnpm-lock.yaml",
    "Gemfile.lock",
    "composer.lock",
    "*.map",
    "*.d.ts",
    "*.pyc",
    "*.pyo",
    "*.class",
    "*.jar",
    "*.war",
    "*.dll",
    "*.so",
    "*.dylib"
  ],
  "test_file_patterns": [
    "test_*",
    "*_test.*",
    "*.spec.*",
    "*.test.*",
    "tests/**",
    "test/**",
    "__tests__/**",
    "spec/**",
    "**/*.test.js",
    "**/*.test.ts",
    "**/*.test.jsx",
    "**/*.test.tsx",
    "**/*.spec.js",
    "**/*.spec.ts",
    "**/*_test.py",
    "**/test_*.py",
    "**/conftest.py"
  ],
  "test_skip_categories": [
    "console.log",
    "debugger",
    "todo_fixme",
    "hardcoded_secret_test",
    "weak_crypto_test",
    "missing_auth_test",
    "error_handling"
  ],
  "test_skip_rule_ids": [],
  "auto_generated_markers": [
    "// AUTO-GENERATED",
    "// AUTOGENERATED",
    "// Generated by",
    "// This file is generated",
    "// Do not edit",
    "// Code generated",
    "# AUTO-GENERATED",
    "# AUTOGENERATED",
    "# Generated by",
    "# This file is generated",
    "# Do not edit",
    "# Code generated",
    "/* AUTO-GENERATED */",
    "/* AUTOGENERATED */",
    "<!-- AUTO-GENERATED -->",
    "/* eslint-disable */",
    "// tslint:disable"
  ],
  "auto_generated_skip_all": true,
  "rule_whitelist": {
    "JS-089": {
      "description": "console.log - 允许在开发环境中使用",
      "allowed_in_dirs": [
        "src/dev/",
        "src/debug/",
        "scripts/"
      ],
      "allowed_when": "process.env.NODE_ENV !== 'production'"
    },
    "JS-016": {
      "description": "eval - 允许在明确安全的场景使用",
      "allowed_in_dirs": [
        "src/evaluator/",
        "src/compiler/"
      ],
      "allowed_when": "输入已通过白名单校验"
    },
    "PY-DEEP-013": {
      "description": "eval/exec - 允许在REPL和配置解析中使用",
      "allowed_in_dirs": [
        "scripts/",
        "tools/",
        "config/"
      ],
      "allowed_when": "使用ast.literal_eval替代"
    }
  },
  "framework_overrides": {
    "django": {
      "skip_rule_ids": [
        "PY-DEEP-045"
      ],
      "description": "Django某些bare except在middleware中是合理的"
    },
    "react": {
      "skip_rule_ids": [
        "JS-087"
      ],
      "description": "React.memo在某些场景下不需要稳定props"
    }
  },
  "confidence_by_severity": {
    "S1": {
      "min_confidence": "high",
      "description": "严重问题必须高置信度"
    },
    "S2": {
      "min_confidence": "medium",
      "description": "中等问题至少中等置信度"
    },
    "S3": {
      "min_confidence": "low",
      "description": "建议性问题可容忍低置信度"
    }
  }
}