        {'rule_id': 'B5003', 'title': '上帝类/上帝函数', 'severity': 'high',
         'description': '单个类或函数承担了整个系统的大部分逻辑。',
         'suggestion': '按职责拆分为多个类/函数，遵循单一职责原则。'},
    ],
    '6': [  # B6 复杂度
        {'rule_id': 'B6001', 'title': '圈复杂度过高', 'severity': 'high',
         'description': '函数的圈复杂度超过阈值（>15），难以理解和测试。',
         'suggestion': '拆分复杂函数，减少条件分支和循环嵌套。'},
        {'rule_id': 'B6002', 'title': '嵌套层级过深', 'severity': 'medium',
         'description': '条件或循环嵌套超过 4 层，降低代码可读性。',
         'suggestion': '使用提前返回、卫语句等方式减少嵌套。'},
        {'rule_id': 'B6003', 'title': '重复代码片段', 'severity': 'medium',
         'description': '检测到多处相似的代码片段，存在重复。',
         'suggestion': '提取公共逻辑为函数或工具类，消除重复代码。'},
    ],
    '7': [  # B7 最佳实践
        {'rule_id': 'B7001', 'title': '缺少单元测试', 'severity': 'low',
         'description': '该函数/模块没有对应的单元测试。',
         'suggestion': '为核心逻辑添加单元测试，确保代码质量。'},
        {'rule_id': 'B7002', 'title': '魔法数字未命名', 'severity': 'low',
         'description': '代码中出现未命名的魔法数字，含义不明确。',
         'suggestion': '将魔法数字定义为有意义的常量。'},
        {'rule_id': 'B7003', 'title': '函数参数过多', 'severity': 'medium',
         'description': '函数参数超过 5 个，调用和维护成本高。',
         'suggestion': '考虑使用配置对象或数据类封装参数。'},
    ],
    '8': [  # B8 依赖扫描
        {'rule_id': 'B8001', 'title': '依赖版本存在已知漏洞', 'severity': 'critical',
         'description': '检测到使用的第三方库版本存在 CVE 安全漏洞。',
         'suggestion': '升级到最新的安全版本，或寻找替代方案。'},
        {'rule_id': 'B8002', 'title': '依赖版本过旧', 'severity': 'medium',
         'description': '使用的依赖库版本已过时，可能缺少重要更新。',
         'suggestion': '升级依赖到较新的稳定版本。'},
        {'rule_id': 'B8003', 'title': '许可证风险', 'severity': 'low',
         'description': '依赖的许可证可能与项目许可证不兼容。',
         'suggestion': '审查依赖许可证，确保与项目使用方式兼容。'},
    ],
}


def mock_scan(files_dict, brain_ids, language='auto'):
    """
    模拟检测结果（等 scanner 开发完成替换为真实调用）
    
    参数:
        files_dict: {file_path: content} 字典
        brain_ids: 要运行的大脑 ID 列表
        language: 编程语言
    
    返回:
        dict: 检测结果
    """
    all_issues = []
    file_paths = list(files_dict.keys())

    # 模拟：每个大脑生成一些问题
    for brain_id in brain_ids:
        rules = MOCK_RULES.get(brain_id, [])
        if not rules:
            continue

        # 随机生成 1-5 个问题
        num_issues = random.randint(1, min(5, len(rules)))
        selected_rules = random.sample(rules, num_issues)

        for rule in selected_rules:
            # 随机选择一个文件和行号
            file_path = random.choice(file_paths) if file_paths else 'unknown'
            content = files_dict.get(file_path, '')
            lines = content.split('\n') if content else ['']
            line_num = random.randint(1, max(1, len(lines)))

            # 获取代码片段（前后各 2 行）
            start_line = max(0, line_num - 2)
            end_line = min(len(lines), line_num + 2)
            snippet_lines = []
            for i in range(start_line, end_line):
                prefix = '> ' if i + 1 == line_num else '  '
                snippet_lines.append(f"{prefix}{i+1:4d}: {lines[i]}")
            code_snippet = '\n'.join(snippet_lines)

            issue = {
                'brain_id': brain_id,
                'brain_name': BRAINS_MAP.get(brain_id, {}).get('name', ''),
                'rule_id': rule['rule_id'],
                'title': rule['title'],
                'severity': rule['severity'],
                'severity_label': severity_label(rule['severity']),
                'description': rule['description'],
                'suggestion': rule['suggestion'],
                'file': file_path,
                'line': line_num,
                'code_snippet': code_snippet,
            }
            all_issues.append(issue)

    # 按严重程度排序
    severity_order = {'critical': 0, 'high': 1, 'medium': 2, 'low': 3}
    all_issues.sort(key=lambda x: (severity_order.get(x['severity'], 99), x['brain_id']))

    return {
        'brains': brain_ids,
        'language': language,
        'issues': all_issues,
        'file_count': len(files_dict),
        'total_issues': len(all_issues),
    }


def call_scanner(files_dict, brain_ids, language='auto'):
    """
    调用 xinpect-scanner v5 检测服务
    
    scanner v5 返回格式:
        {status, total_elapsed, results: {brain_id: {score, issues, ...}}}
    每个 issue 字段: check_id, name, severity, file, line, message, suggestion
    """
    try:
        import requests
        resp = requests.post(SCANNER_URL, json={
            'code_files': files_dict,
            'brain_ids': brain_ids,
        }, timeout=120)
        resp.raise_for_status()
        raw = resp.json()

        # 格式适配：把按 brain 分组的 issues 拍平成前端需要的格式
        all_issues = []
        results_by_brain = raw.get('results', {})

        for bid in brain_ids:
            brain_result = results_by_brain.get(str(bid), {})
            brain_issues = brain_result.get('issues', [])
            brain_name = BRAINS_MAP.get(str(bid), {}).get('name', f'B{bid}')

            for issue in brain_issues:
                # 提取代码片段（从原文件内容里取）
                file_path = issue.get('file', '')
                line_num = issue.get('line', 0)
                content = files_dict.get(file_path, '')
                code_snippet = ''
                if content and line_num:
                    lines = content.split('\n')
                    start = max(0, line_num - 3)
                    end = min(len(lines), line_num + 2)
                    snippet_lines = []
                    for i in range(start, end):
                        marker = '> ' if i + 1 == line_num else '  '
                        snippet_lines.append(f"{marker}{i+1:4d}: {lines[i]}")
                    code_snippet = '\n'.join(snippet_lines)

                all_issues.append({
                    'brain_id': str(bid),
                    'brain_name': brain_name,
                    'rule_id': issue.get('check_id', ''),
                    'title': issue.get('name', issue.get('check_id', '')),
                    'severity': issue.get('severity', 'medium'),
                    'severity_label': severity_label(issue.get('severity', 'medium')),
                    'description': issue.get('message', ''),
                    'suggestion': issue.get('suggestion', ''),
                    'file': file_path,
                    'line': line_num,
                    'code_snippet': code_snippet,
                    'category': issue.get('category', ''),
                })

        # 按严重程度排序
        sev_order = {'critical': 0, 'high': 1, 'medium': 2, 'low': 3, 'info': 4}
        all_issues.sort(key=lambda x: (sev_order.get(x.get('severity', ''), 99),
                                        str(x.get('brain_id', ''))))

        return {
            'brains': brain_ids,
            'language': language,
            'issues': all_issues,
            'file_count': len(files_dict),
            'total_issues': len(all_issues),
            'scan_time': raw.get('total_elapsed', 0),
            'version': raw.get('version', '5.0'),
        }
    except Exception as e:
        app.logger.error(f'Scanner call failed: {e}')
        import traceback
        app.logger.error(traceback.format_exc())
        # fallback 到 mock，保证网站可用
        return mock_scan(files_dict, brain_ids, language)


