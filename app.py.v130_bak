@app.route('/')
def index():
    """首页"""
    return render_template('index.html', brains=BRAINS)


@app.route('/upload')
def upload_page():
    """上传页"""
    allowed, remaining = check_daily_limit()
    return render_template('upload.html', daily_remaining=remaining)


@app.route('/scan', methods=['POST'])
def scan():
    """发起检测（返回 JSON）"""
    # 检查每日限制
    allowed, remaining = check_daily_limit()
    if not allowed:
        return jsonify({'error': '今日检测次数已用完，请明天再试或升级会员'}), 429

    # 收集文件
    files_dict = {}

    # 支持的代码文件扩展名
    CODE_EXTS = {'.py', '.js', '.ts', '.tsx', '.jsx', '.java', '.go', '.cpp', '.c',
                 '.h', '.cs', '.php', '.rb', '.rs', '.swift', '.kt', '.wxml', '.wxss',
                 '.vue', '.html', '.htm', '.scss', '.less', '.css', '.sass',
                 '.json', '.yaml', '.yml', '.toml', '.ini', '.sh', '.bash'}

    def _extract_archive(file_storage):
        """从压缩包中提取代码文件，返回 {path: content} 字典"""
        result = {}
        filename = file_storage.filename.lower()
        data = file_storage.read()

        try:
            if filename.endswith('.zip'):
                with zipfile.ZipFile(io.BytesIO(data)) as zf:
                    for info in zf.infolist():
                        if info.is_dir():
                            continue
                        # 跳过隐藏文件、__pycache__、node_modules 等
                        name = info.filename
                        if any(x in name for x in ('__pycache__', 'node_modules', '.git/',
                                                    'dist/', 'build/', '.venv', 'venv/',
                                                    '.DS_Store', 'Thumbs.db')):
                            continue
                        if name.startswith('.') or '/.' in name:
                            continue
                        ext = os.path.splitext(name)[1].lower()
                        if ext in CODE_EXTS:
                            try:
                                with zf.open(info) as f:
                                    content = f.read().decode('utf-8', errors='replace')
                                # 去掉 zip 最外层目录前缀，让路径更干净
                                parts = name.split('/', 1)
                                display_name = parts[1] if len(parts) > 1 else parts[0]
                                result[display_name] = content
                            except:
                                pass

            elif filename.endswith(('.tar.gz', '.tgz', '.tar')):
                with tarfile.open(fileobj=io.BytesIO(data), mode='r:*') as tf:
                    for member in tf.getmembers():
                        if not member.isfile():
                            continue
                        name = member.name
                        if any(x in name for x in ('__pycache__', 'node_modules', '.git/',
                                                    'dist/', 'build/', '.venv', 'venv/',
                                                    '.DS_Store', 'Thumbs.db')):
                            continue
                        if name.startswith('.') or '/.' in name:
                            continue
                        ext = os.path.splitext(name)[1].lower()
                        if ext in CODE_EXTS:
                            try:
                                f = tf.extractfile(member)
                                if f:
                                    content = f.read().decode('utf-8', errors='replace')
                                    parts = name.split('/', 1)
                                    display_name = parts[1] if len(parts) > 1 else parts[0]
                                    result[display_name] = content
                            except:
                                pass
        except Exception as e:
            # 解压失败就跳过，不让整个扫描挂掉
            pass

        return result

    # 方式1：上传文件（支持单文件、多文件、zip/tar.gz 压缩包）
    uploaded_files = request.files.getlist('files')
    if uploaded_files and uploaded_files[0].filename:
        for f in uploaded_files:
            if f and f.filename:
                fname_lower = f.filename.lower()
                # 压缩包：解压后扫描里面的代码文件
                if fname_lower.endswith(('.zip', '.tar.gz', '.tgz', '.tar')):
                    extracted = _extract_archive(f)
                    files_dict.update(extracted)
                else:
                    # 普通代码文件：直接读
                    content = f.read().decode('utf-8', errors='replace')
                    files_dict[f.filename] = content

    # 方式2：粘贴代码
    code = request.form.get('code', '').strip()
    if code:
        filename = request.form.get('filename', 'code.txt') or 'code.txt'
        files_dict[filename] = code

    if not files_dict:
        return jsonify({'error': '请上传文件或粘贴代码'}), 400

    language = request.form.get('language', 'auto')

    # 判断可用的大脑
    vip = is_vip_user()
    if vip:
        brain_ids = ['1', '2', '3', '4', '5', '6', '7', '8']
    else:
        brain_ids = ['1', '2', '3']  # 免费用户只有 B1~B3

    # 调用检测
    results = call_scanner(files_dict, brain_ids, language)

    # 计算得分（免费用户只按 B1~B3 计算）
    score = calculate_score(results['issues'], available_brain_ids=(None if vip else ['1','2','3']))
    grade = score_to_grade(score)

    # 生成 scan_id
    scan_id = hashlib.sha256(f"{uuid.uuid4()}{datetime.now().isoformat()}".encode()).hexdigest()[:32]

    # 构建标题
    first_file = list(files_dict.keys())[0] if files_dict else 'unknown'
    if len(files_dict) > 1:
        title = f"{first_file} 等 {len(files_dict)} 个文件"
    else:
        title = first_file

    # 保存到数据库
    user_id = session.get('user_id')
    db = get_db()
    db.execute('''
        INSERT INTO scans (scan_id, user_id, title, file_count, files_meta,
                          results, score, grade, issue_count, language)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    ''', (
        scan_id,
        user_id,
        title,
        len(files_dict),
        json.dumps(list(files_dict.keys()), ensure_ascii=False),
        json.dumps(results, ensure_ascii=False),
        score,
        grade,
        results['total_issues'],
        language,
    ))
    db.commit()

    # 增加使用次数
    increment_daily_usage()

    return jsonify({
        'scan_id': scan_id,
        'score': score,
        'grade': grade,
        'total_issues': results['total_issues'],
    })


@app.route('/report/<scan_id>')
def report_page(scan_id):
    """报告页"""
    db = get_db()
    scan = db.execute('SELECT * FROM scans WHERE scan_id = ?', (scan_id,)).fetchone()

    if not scan:
        flash('检测报告不存在', 'error')
        return redirect(url_for('index'))

    # 权限检查：如果是用户自己的检测，或者未登录用户的检测（通过 session 标记）
    # MVP 阶段：公开可访问（方便分享），后续可加权限控制

    results = json.loads(scan['results']) if scan['results'] else {'issues': []}
    all_issues = results.get('issues', [])
    vip = is_vip_user()

    # 构建维度数据
    dimensions = []
    for brain in BRAINS:
        brain_issues = [i for i in all_issues if str(i.get('brain_id')) == brain['id']]
        is_locked = (not vip) and (brain['id'] not in ['1', '2', '3'])

        if is_locked:
            dimensions.append({
                'id': brain['id'],
                'name': brain['name'],
                'score': '—',
                'score_color': '#6b7280',
                'issues_count': '🔒',
                'locked': True,
            })
        else:
            dim_score = calculate_dimension_score(brain_issues)
            dimensions.append({
                'id': brain['id'],
                'name': brain['name'],
                'score': dim_score,
                'score_color': score_color(dim_score),
                'issues_count': len(brain_issues),
                'locked': False,
            })

    # 可见问题（免费用户只看 B1~B3）
    if vip:
        visible_issues = all_issues
    else:
        visible_issues = [i for i in all_issues if str(i.get('brain_id')) in ['1', '2', '3']]

    # 计算综合得分（按可见维度计算）
    score = scan['score']
    grade = scan['grade']

    created_at = scan['created_at']
    try:
        dt = datetime.strptime(created_at, '%Y-%m-%d %H:%M:%S')
        created_at_str = dt.strftime('%Y-%m-%d %H:%M')
    except:
        created_at_str = created_at

    return render_template(
        'report.html',
        scan_id=scan_id,
        report_title=scan['title'],
        score=score,
        grade=grade,
        file_count=scan['file_count'],
        total_issues=scan['issue_count'],
        created_at=created_at_str,
        dimensions=dimensions,
        visible_issues=visible_issues,
        visible_issues_count=len(visible_issues),
        is_vip=vip,
    )


@app.route('/report/<scan_id>/download')
def download_report(scan_id):
    """下载报告（Markdown 格式）"""
    db = get_db()
    scan = db.execute('SELECT * FROM scans WHERE scan_id = ?', (scan_id,)).fetchone()

    if not scan:
        flash('检测报告不存在', 'error')
        return redirect(url_for('index'))

    results = json.loads(scan['results']) if scan['results'] else {'issues': []}
    all_issues = results.get('issues', [])
    vip = is_vip_user()

    if vip:
        visible_issues = all_issues
        visible_brains = BRAINS
    else:
        visible_issues = [i for i in all_issues if str(i.get('brain_id')) in ['1', '2', '3']]
        visible_brains = [b for b in BRAINS if b['id'] in ['1', '2', '3']]

    # 生成 Markdown
    md_lines = []
    md_lines.append(f'# 煋鉴 Xinpect 代码检测报告')
    md_lines.append('')
    md_lines.append(f'**检测名称：** {scan["title"]}')
    md_lines.append(f'**检测时间：** {scan["created_at"]}')
    md_lines.append(f'**文件数量：** {scan["file_count"]}')
    md_lines.append(f'**综合得分：** {scan["score"]} / 100 ({scan["grade"]}级)')
    md_lines.append(f'**问题总数：** {len(visible_issues)}')
    if not vip:
        md_lines.append(f'> ⚡ 免费版仅展示 B1~B3 结果，[升级专业版](https://xinpect.xingwangzhineng.com) 解锁全部 8 维度')
    md_lines.append('')
    md_lines.append('---')
    md_lines.append('')

    # 各维度得分
    md_lines.append('## 各维度得分')
    md_lines.append('')
    md_lines.append('| 维度 | 名称 | 得分 | 问题数 |')
    md_lines.append('|------|------|------|--------|')
    for brain in BRAINS:
        if vip or brain['id'] in ['1', '2', '3']:
            brain_issues = [i for i in visible_issues if str(i.get('brain_id')) == brain['id']]
            dim_score = calculate_dimension_score(brain_issues)
            md_lines.append(f'| B{brain["id"]} | {brain["name"]} | {dim_score} | {len(brain_issues)} |')
        else:
            md_lines.append(f'| B{brain["id"]} | {brain["name"]} | 🔒 升级解锁 | - |')
    md_lines.append('')

    # 问题详情
    md_lines.append('## 问题详情')
    md_lines.append('')

    if not visible_issues:
        md_lines.append('🎉 **未检测到任何问题，代码质量优秀！**')
    else:
        # 按维度分组
        for brain in visible_brains:
            brain_issues = [i for i in visible_issues if str(i.get('brain_id')) == brain['id']]
            if not brain_issues:
                continue

            md_lines.append(f'### B{brain["id"]} {brain["name"]}')
            md_lines.append('')

            for idx, issue in enumerate(brain_issues, 1):
                sev_label = issue.get('severity_label', issue['severity'])
                md_lines.append(f'#### [{sev_label}] {idx}. {issue["title"]}')
                md_lines.append('')
                md_lines.append(f'- **规则ID：** {issue["rule_id"]}')
                md_lines.append(f'- **位置：** `{issue["file"]}:{issue["line"]}`')
                md_lines.append('')
                md_lines.append('**问题描述：**')
                md_lines.append('')
                md_lines.append(issue['description'])
                md_lines.append('')

                if issue.get('code_snippet'):
                    md_lines.append('**问题代码：**')
                    md_lines.append('')
                    md_lines.append('```')
                    md_lines.append(issue['code_snippet'])
                    md_lines.append('```')
                    md_lines.append('')

                if issue.get('suggestion'):
                    md_lines.append('**修复建议：**')
                    md_lines.append('')
                    md_lines.append(f'> {issue["suggestion"]}')
                    md_lines.append('')

            md_lines.append('---')
            md_lines.append('')

    md_lines.append('')
    md_lines.append('---')
    md_lines.append(f'*本报告由 [煋鉴 Xinpect](https://xinpect.xingwangzhineng.com) 自动生成*')

    md_content = '\n'.join(md_lines)

    # 生成响应
    response = make_response(md_content)
    response.headers['Content-Type'] = 'text/markdown; charset=utf-8'
    response.headers['Content-Disposition'] = f'attachment; filename="xinpect-report-{scan_id[:8]}.md"'
    return response


# ============================================================
# 认证路由
# ============================================================

@app.route('/login', methods=['GET', 'POST'])
def login():
    """登录"""
    if request.method == 'POST':
        email = request.form.get('email', '').strip().lower()
        password = request.form.get('password', '')

        errors = {}

        if not email or not re.match(r'^[\w\.-]+@[\w\.-]+\.\w+$', email):
            errors['error_email'] = '请输入有效的邮箱地址'

        if not password:
            errors['error_password'] = '请输入密码'

        if errors:
            return render_template('login.html', email=email, **errors)

        db = get_db()
        user = db.execute('SELECT * FROM users WHERE email = ?', (email,)).fetchone()

        if not user or not check_password_hash(user['password_hash'], password):
            errors['error_password'] = '邮箱或密码错误'
            return render_template('login.html', email=email, **errors)

        # 登录成功
        session['user_id'] = user['id']
        session['user_email'] = user['email']
        session['is_vip'] = bool(user['is_vip'])
        session['bonus_credits'] = user['bonus_credits'] or 0

        # 补写门房密码哈希（老用户没有）
        mf_pwd_hash = user['mf_password_hash'] if user['mf_password_hash'] else None
        if not mf_pwd_hash:
            mf_pwd_hash = hashlib.sha256(password.encode('utf-8')).hexdigest()
            db.execute('UPDATE users SET mf_password_hash = ? WHERE id = ?', (mf_pwd_hash, user['id']))
            db.commit()

        # 同步登录门房，拿支付用的 token（失败不影响主流程）
        mf_token = _menfang_login_with_hash(email, mf_pwd_hash)
        if mf_token:
            session['mf_token'] = mf_token
        else:
            # 可能是老用户，门房没注册过，尝试补注册再登录
            _menfang_ensure_registered(email, mf_pwd_hash)
            mf_token = _menfang_login_with_hash(email, mf_pwd_hash)
            if mf_token:
                session['mf_token'] = mf_token

        flash('登录成功', 'success')

        next_url = request.args.get('next')
        if next_url and next_url.startswith('/'):
            return redirect(next_url)
        return redirect(url_for('dashboard_page'))

    return render_template('login.html')


@app.route('/register', methods=['GET', 'POST'])
def register():
    """注册"""
    if request.method == 'POST':
        email = request.form.get('email', '').strip().lower()
        password = request.form.get('password', '')
        confirm_password = request.form.get('confirm_password', '')

        errors = {}

        if not email or not re.match(r'^[\w\.-]+@[\w\.-]+\.\w+$', email):
            errors['error_email'] = '请输入有效的邮箱地址'

        if len(password) < 6:
            errors['error_password'] = '密码至少 6 位字符'

        if password != confirm_password:
            errors['error_confirm'] = '两次输入的密码不一致'

        if errors:
            return render_template('register.html', email=email, **errors)

        db = get_db()

        # 检查邮箱是否已注册
        existing = db.execute('SELECT id FROM users WHERE email = ?', (email,)).fetchone()
        if existing:
            errors['error_email'] = '该邮箱已被注册'
            return render_template('register.html', email=email, **errors)

        # 创建用户
        password_hash = generate_password_hash(password)
        mf_pwd_hash = hashlib.sha256(password.encode('utf-8')).hexdigest()
        cursor = db.execute(
            'INSERT INTO users (email, password_hash, mf_password_hash) VALUES (?, ?, ?)',
            (email, password_hash, mf_pwd_hash)
        )
        db.commit()

        user_id = cursor.lastrowid

        # 同步注册到门房服务（用于支付，失败不影响主流程）
        _menfang_ensure_registered(email, mf_pwd_hash)

        # 自动登录
        session['user_id'] = user_id
        session['user_email'] = email
        session['is_vip'] = False

        flash('注册成功，欢迎使用煋鉴！', 'success')
        return redirect(url_for('dashboard_page'))

    return render_template('register.html')


@app.route('/logout')
def logout():
    """登出"""
    session.clear()
    flash('已退出登录', 'info')
    return redirect(url_for('index'))


# ============================================================
# 会员中心
# ============================================================

@app.route('/dashboard')
@app.route('/dashboard/<page>')
@login_required
def dashboard_page(page='overview'):
    """会员中心各页面"""
    user = get_current_user()
    vip = is_vip_user()
    db = get_db()

    # 通用上下文
    context = {
        'user_email': user['email'] if user else '',
        'is_vip': vip,
        'page': page,
        'bonus_credits': user['bonus_credits'] if user else 0,
    }

    if page == 'overview':
        # 概览页：统计数据 + 最近检测
        today = datetime.now().strftime('%Y-%m-%d')
        usage_row = db.execute(
            'SELECT count FROM daily_usage WHERE date = ? AND user_id = ?',
            (today, user['id'])
        ).fetchone()
        today_scans = usage_row['count'] if usage_row else 0

        total_scans_row = db.execute(
            'SELECT COUNT(*) as cnt, COALESCE(SUM(issue_count), 0) as issues FROM scans WHERE user_id = ?',
            (user['id'],)
        ).fetchone()

        remaining = max(0, DAILY_LIMIT_REGISTERED - today_scans) if not vip else -1

        vip_expire = ''
        if vip and user['vip_expire_at']:
            try:
                vip_expire = user['vip_expire_at']
            except:
                vip_expire = '永久'

        context['stats'] = {
            'total_scans': total_scans_row['cnt'],
            'today_scans': today_scans,
            'remaining': remaining,
            'total_issues': total_scans_row['issues'],
        }
        context['vip_expire'] = vip_expire

        # 最近 5 条检测
        recent = db.execute(
            'SELECT scan_id, title, file_count, issue_count, score, grade, created_at '
            'FROM scans WHERE user_id = ? ORDER BY created_at DESC LIMIT 5',
            (user['id'],)
        ).fetchall()
        context['recent_scans'] = [dict(r) for r in recent]

        return render_template('dashboard/overview.html', **context)

    elif page == 'scans':
        # 我的检测
        scans = db.execute(
            'SELECT scan_id, title, file_count, issue_count, score, grade, created_at '
            'FROM scans WHERE user_id = ? ORDER BY created_at DESC',
            (user['id'],)
        ).fetchall()
        context['scans'] = [dict(s) for s in scans]
        return render_template('dashboard/scans.html', **context)

    elif page == 'orders':
        # 订单列表
        orders = db.execute(
            'SELECT order_id, plan_id, plan_name, amount, status, created_at '
            'FROM orders WHERE user_id = ? ORDER BY created_at DESC',
            (user['id'],)
        ).fetchall()
        context['orders'] = [dict(o) for o in orders]
        return render_template('dashboard/orders.html', **context)

    elif page == 'recharge':
        # 充值页
        return render_template('dashboard/recharge.html', **context)

    else:
        return redirect(url_for('dashboard_page', page='overview'))


# ============================================================
# JSON API
# ============================================================

@app.route('/api/pay/create', methods=['POST'])
@login_required
def api_pay_create():
    """创建支付订单（对接门房真实微信支付）"""
    data = request.get_json() or {}
    plan_id = data.get('plan_id')
    order_type = data.get('order_type', 'subscription')  # subscription / topup

    # 网站套餐 → 门房套餐映射
    subscription_plans = {
        'monthly':     {'name': '月卡',   'amount': 99,  'mf_plan': 'monthly'},
        'quarterly':   {'name': '季卡',   'amount': 249, 'mf_plan': 'quarterly'},
        'half_year':   {'name': '半年卡', 'amount': 449, 'mf_plan': 'half-year'},
        'yearly':      {'name': '年卡',   'amount': 799, 'mf_plan': 'yearly'},
    }

    topup_plans = {
        'topup_1':  {'name': '次卡·1次',  'amount': 2,  'mf_plan': 'addon-1',  'credits': 1},
        'topup_5':  {'name': '次卡·5次',  'amount': 9,  'mf_plan': 'addon-5',  'credits': 5},
        'topup_10': {'name': '次卡·10次', 'amount': 16, 'mf_plan': 'addon-10', 'credits': 10},
    }

    if order_type == 'topup':
        # 次卡仅限会员购买
        if not is_vip_user():
            return jsonify({'success': False, 'error': '次卡仅限会员购买，请先开通会员'}), 403
        if plan_id not in topup_plans:
            return jsonify({'success': False, 'error': '无效的次卡套餐'}), 400
        plan = topup_plans[plan_id]
    else:
        if plan_id not in subscription_plans:
            return jsonify({'success': False, 'error': '无效的套餐'}), 400
        plan = subscription_plans[plan_id]

    user = get_current_user()
    email = user['email']
    mf_token = session.get('mf_token', '')
    mf_pwd_hash = user['mf_password_hash'] or ''

    # 调门房创建真实支付订单（先试 token，失败就用密码哈希重登再试）
    result = _menfang_create_pay_order_with_token(email, mf_token, plan['mf_plan'], plan['amount'])

    # token 失效时用密码哈希重新登录再试
    if not result['success'] and mf_pwd_hash and ('登录已过期' in result.get('message', '') or '会话' in result.get('message', '')):
        new_token = _menfang_login_with_hash(email, mf_pwd_hash)
        if new_token:
            session['mf_token'] = new_token
            result = _menfang_create_pay_order_with_token(email, new_token, plan['mf_plan'], plan['amount'])

    # 还失败就用密码哈希直接调（最兜底的方式）
    if not result['success'] and mf_pwd_hash:
        result = _menfang_create_pay_order_with_hash(email, mf_pwd_hash, plan['mf_plan'], plan['amount'])

    if not result['success']:
        return jsonify({'success': False, 'error': result.get('message', '创建订单失败')}), 400

    mf_order_id = result['order_id']

    # 存本地订单（用门房的 order_id 作为关联）
    db = get_db()
    db.execute('''
        INSERT INTO orders (order_id, user_id, plan_id, plan_name, order_type, amount, status, mf_order_id)
        VALUES (?, ?, ?, ?, ?, ?, 'pending', ?)
    ''', (mf_order_id, user['id'], plan_id, plan['name'], order_type, plan['amount'], mf_order_id))
    db.commit()

    return jsonify({
        'success': True,
        'order_id': mf_order_id,
        'amount': plan['amount'],
        'qr_url': result.get('qr_code_url', ''),
    })


@app.route('/api/pay/status/<order_id>')
@login_required
def api_pay_status(order_id):
    """查询支付状态（轮询门房真实订单状态）"""
    user = get_current_user()
    db = get_db()

    order = db.execute(
        'SELECT * FROM orders WHERE order_id = ? AND user_id = ?',
        (order_id, user['id'])
    ).fetchone()

    if not order:
        return jsonify({'status': 'not_found'}), 404

    # 如果本地已是 paid，直接返回
    if order['status'] == 'paid':
        return jsonify({'status': 'paid'})

    # 调门房查真实支付状态
    mf_status = _menfang_get_order_status(order_id)

    if not mf_status['found']:
        return jsonify({'status': order['status']})

    # 支付成功 → 开通权限
    if mf_status['status'] == 'paid' and order['status'] != 'paid':
        if order['order_type'] == 'topup':
            # 次卡：加 bonus_credits
            credits_map = {
                'topup_1': 1,
                'topup_5': 5,
                'topup_10': 10,
            }
            credits = credits_map.get(order['plan_id'], 1)
            db.execute('''
                UPDATE orders SET status = 'paid', paid_at = datetime('now', 'localtime')
                WHERE order_id = ?
            ''', (order_id,))
            db.execute('''
                UPDATE users SET bonus_credits = COALESCE(bonus_credits, 0) + ? WHERE id = ?
            ''', (credits, user['id']))
            db.commit()
            session['bonus_credits'] = (session.get('bonus_credits') or 0) + credits
            return jsonify({'status': 'paid'})
        else:
            # 订阅卡：开 vip
            days_map = {
                'monthly': 30,
                'quarterly': 90,
                'half_year': 180,
                'yearly': 365,
            }
            days = days_map.get(order['plan_id'], 30)
            # 从门房的 paid_at 算起更准确，没有就用当前时间
            vip_expire = (datetime.now() + timedelta(days=days)).strftime('%Y-%m-%d %H:%M:%S')

            db.execute('''
                UPDATE orders SET status = 'paid', paid_at = datetime('now', 'localtime')
                WHERE order_id = ?
            ''', (order_id,))
            db.execute('''
                UPDATE users SET is_vip = 1, vip_expire_at = ? WHERE id = ?
            ''', (vip_expire, user['id']))
            db.commit()

            # 更新 session
            session['is_vip'] = True

            return jsonify({'status': 'paid'})

    return jsonify({'status': mf_status.get('status', order['status'])})


# ============================================================
# 错误处理
# ============================================================

@app.errorhandler(404)
def page_not_found(e):
    return render_template('404.html'), 404


@app.errorhandler(413)
def too_large(e):
    return jsonify({'error': '上传文件过大，总大小不能超过 20MB'}), 413


@app.errorhandler(500)
def server_error(e):
    app.logger.exception('Server error')
    return jsonify({'error': '服务器内部错误'}), 500


