# ============================================================
# 数据库
# ============================================================

def get_db():
    """获取数据库连接，每个请求一个连接"""
    if 'db' not in g:
        g.db = sqlite3.connect(DB_PATH)
        g.db.row_factory = sqlite3.Row
        g.db.execute('PRAGMA journal_mode=WAL')
        g.db.execute('PRAGMA foreign_keys=ON')
    return g.db


@app.teardown_appcontext
def close_db(exception):
    """请求结束时关闭数据库连接"""
    db = g.pop('db', None)
    if db is not None:
        db.close()


def init_db():
    """初始化数据库表"""
    conn = sqlite3.connect(DB_PATH)
    conn.executescript('''
        -- 用户表
        CREATE TABLE IF NOT EXISTS users (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            email TEXT UNIQUE NOT NULL,
            password_hash TEXT NOT NULL,
            is_vip INTEGER DEFAULT 0,
            vip_expire_at TEXT,
            bonus_credits INTEGER DEFAULT 0,
            created_at TEXT DEFAULT (datetime('now', 'localtime'))
        );

        -- 扫描记录表
        CREATE TABLE IF NOT EXISTS scans (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            scan_id TEXT UNIQUE NOT NULL,
            user_id INTEGER,
            title TEXT,
            file_count INTEGER DEFAULT 0,
            files_meta TEXT,          -- JSON: 文件名列表
            results TEXT,             -- JSON: 完整检测结果
            score INTEGER DEFAULT 100,
            grade TEXT DEFAULT 'A',
            issue_count INTEGER DEFAULT 0,
            language TEXT,
            created_at TEXT DEFAULT (datetime('now', 'localtime')),
            FOREIGN KEY (user_id) REFERENCES users(id)
        );

        -- 订单表
        CREATE TABLE IF NOT EXISTS orders (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            order_id TEXT UNIQUE NOT NULL,
            user_id INTEGER NOT NULL,
            plan_id TEXT,
            plan_name TEXT,
            order_type TEXT DEFAULT 'subscription',  -- subscription / topup
            amount REAL DEFAULT 0,
            status TEXT DEFAULT 'pending',  -- pending / paid / expired
            pay_method TEXT,
            paid_at TEXT,
            created_at TEXT DEFAULT (datetime('now', 'localtime')),
            FOREIGN KEY (user_id) REFERENCES users(id)
        );

        -- 每日使用量表（按 IP 或 user_id 统计）
        CREATE TABLE IF NOT EXISTS daily_usage (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            date TEXT NOT NULL,
            user_id INTEGER,
            ip TEXT,
            count INTEGER DEFAULT 0,
            UNIQUE(date, user_id, ip)
        );

        CREATE INDEX IF NOT EXISTS idx_scans_user ON scans(user_id);
        CREATE INDEX IF NOT EXISTS idx_orders_user ON orders(user_id);
        CREATE INDEX IF NOT EXISTS idx_scans_scan_id ON scans(scan_id);
    ''')
    # 列迁移：兼容已有数据库，补字段
    try:
        conn.execute('ALTER TABLE users ADD COLUMN bonus_credits INTEGER DEFAULT 0')
    except sqlite3.OperationalError:
        pass
    try:
        conn.execute("ALTER TABLE orders ADD COLUMN order_type TEXT DEFAULT 'subscription'")
    except sqlite3.OperationalError:
        pass
    try:
        conn.execute("ALTER TABLE orders ADD COLUMN mf_order_id TEXT")
    except sqlite3.OperationalError:
        pass
    try:
        conn.execute("ALTER TABLE users ADD COLUMN mf_password_hash TEXT")
    except sqlite3.OperationalError:
        pass
    conn.commit()
    conn.close()


# ============================================================
# 工具函数
# ============================================================

def login_required(f):
    """登录装饰器"""
    @wraps(f)
    def decorated_function(*args, **kwargs):
        if not session.get('user_id'):
            flash('请先登录', 'warning')
            return redirect(url_for('login', next=request.path))
        return f(*args, **kwargs)
    return decorated_function


def get_current_user():
    """获取当前登录用户"""
    user_id = session.get('user_id')
    if not user_id:
        return None
    db = get_db()
    return db.execute('SELECT * FROM users WHERE id = ?', (user_id,)).fetchone()


def is_vip_user():
    """判断当前用户是否为付费会员"""
    user = get_current_user()
    if not user:
        return False
    if user['is_vip']:
        # 检查是否过期
        if user['vip_expire_at']:
            expire = datetime.strptime(user['vip_expire_at'], '%Y-%m-%d %H:%M:%S')
            if expire > datetime.now():
                return True
            else:
                # 过期了，更新状态
                db = get_db()
                db.execute('UPDATE users SET is_vip = 0 WHERE id = ?', (user['id'],))
                db.commit()
                return False
        return True  # 没设置过期时间，永久有效
    return False


# ============================================================
# 门房服务辅助函数（支付+权限中心）
# ============================================================
def _menfang_ensure_registered(email: str, password_hash: str) -> bool:
    """
    确保用户在门房服务中也注册了（用于支付对接）。
    password_hash 是 sha256 hex（和门房一致）。
    注册成功或已存在返回 True，失败返回 False（不阻塞网站流程）。
    """
    if not HAS_REQUESTS:
        return False
    try:
        resp = http_requests.post(
            f'{MENFANG_BASE_URL}/api/auth/register',
            json={'email': email, 'password_hash': password_hash},
            timeout=5
        )
        # 200=注册成功，409=已存在，都算成功
        return resp.status_code in (200, 409)
    except Exception as e:
        print(f'[门房] 同步注册失败 {email}: {e}')
        return False


def _menfang_login_with_hash(email: str, password_hash: str) -> str:
    """
    用 sha256 密码哈希登录门房获取 token。成功返回 token，失败返回空字符串。
    """
    if not HAS_REQUESTS:
        return ''
    try:
        resp = http_requests.post(
            f'{MENFANG_BASE_URL}/api/auth/login',
            json={'email': email, 'password_hash': password_hash},
            timeout=5
        )
        data = resp.json()
        if data.get('success'):
            return data.get('token', '')
    except Exception as e:
        print(f'[门房] 登录失败 {email}: {e}')
    return ''


def _menfang_create_pay_order_with_token(email: str, token: str, plan: str, amount: int) -> dict:
    """
    用 token 调用门房创建支付订单（推荐方式，避免传递密码）。
    返回: {success, order_id, qr_code_url, amount, message}
    """
    if not HAS_REQUESTS:
        return {'success': False, 'message': '支付服务未就绪'}
    try:
        headers = {}
        if token:
            headers['Authorization'] = f'Bearer {token}'
        resp = http_requests.post(
            f'{MENFANG_BASE_URL}/api/pay/create',
            json={
                'email': email,
                'plan': plan,
                'amount': amount
            },
            headers=headers,
            timeout=10
        )
        data = resp.json()
        if data.get('success'):
            return {
                'success': True,
                'order_id': data.get('order_id', ''),
                'qr_code_url': data.get('qr_code_url', ''),
                'amount': data.get('amount', amount)
            }
        else:
            return {'success': False, 'message': data.get('message', '创建订单失败')}
    except Exception as e:
        print(f'[门房] 创建支付订单失败: {e}')
        return {'success': False, 'message': '支付服务暂时不可用，请稍后重试'}


def _menfang_create_pay_order_with_hash(email: str, password_hash: str, plan: str, amount: int) -> dict:
    """
    用 password_hash 直接调用门房创建支付订单（兜底方式，token 都不可用时用）。
    返回: {success, order_id, qr_code_url, amount, message}
    """
    if not HAS_REQUESTS:
        return {'success': False, 'message': '支付服务未就绪'}
    try:
        resp = http_requests.post(
            f'{MENFANG_BASE_URL}/api/pay/create',
            json={
                'email': email,
                'password_hash': password_hash,
                'plan': plan,
                'amount': amount
            },
            timeout=10
        )
        data = resp.json()
        if data.get('success'):
            return {
                'success': True,
                'order_id': data.get('order_id', ''),
                'qr_code_url': data.get('qr_code_url', ''),
                'amount': data.get('amount', amount)
            }
        else:
            return {'success': False, 'message': data.get('message', '创建订单失败')}
    except Exception as e:
        print(f'[门房] 创建支付订单(hash方式)失败: {e}')
        return {'success': False, 'message': '支付服务暂时不可用，请稍后重试'}


def _menfang_get_order_status(order_id: str) -> dict:
    """
    查询门房订单支付状态。
    返回: {found, status, plan, amount, paid_at}
    """
    if not HAS_REQUESTS:
        return {'found': False, 'status': 'unknown'}
    try:
        resp = http_requests.get(
            f'{MENFANG_BASE_URL}/api/pay/order-status/{order_id}',
            timeout=5
        )
        if resp.status_code == 404:
            return {'found': False, 'status': 'not_found'}
        data = resp.json()
        return {
            'found': True,
            'status': data.get('status', 'unknown'),
            'plan': data.get('plan', ''),
            'amount': data.get('amount', 0),
            'paid_at': data.get('paid_at', '')
        }
    except Exception as e:
        print(f'[门房] 查询订单状态失败 {order_id}: {e}')
        return {'found': False, 'status': 'error'}


def get_daily_usage():
    """获取今日使用次数"""
    db = get_db()
    today = datetime.now().strftime('%Y-%m-%d')
    user_id = session.get('user_id')
    ip = request.remote_addr

    if user_id:
        row = db.execute(
            'SELECT count FROM daily_usage WHERE date = ? AND user_id = ?',
            (today, user_id)
        ).fetchone()
    else:
        row = db.execute(
            'SELECT count FROM daily_usage WHERE date = ? AND ip = ? AND user_id IS NULL',
            (today, ip)
        ).fetchone()

    return row['count'] if row else 0


def check_daily_limit():
    """检查是否超过每日限制，返回 (是否允许, 剩余次数)"""
    if is_vip_user():
        return True, -1  # VIP 无限

    usage = get_daily_usage()
    limit = DAILY_LIMIT_REGISTERED if session.get('user_id') else DAILY_LIMIT_FREE
    remaining = max(0, limit - usage)
    return remaining > 0, remaining


def increment_daily_usage():
    """增加今日使用次数"""
    db = get_db()
    today = datetime.now().strftime('%Y-%m-%d')
    user_id = session.get('user_id')
    ip = request.remote_addr

    if user_id:
        db.execute('''
            INSERT INTO daily_usage (date, user_id, ip, count)
            VALUES (?, ?, ?, 1)
            ON CONFLICT(date, user_id, ip)
            DO UPDATE SET count = count + 1
        ''', (today, user_id, ip))
    else:
        db.execute('''
            INSERT INTO daily_usage (date, user_id, ip, count)
            VALUES (?, NULL, ?, 1)
            ON CONFLICT(date, user_id, ip)
            DO UPDATE SET count = count + 1
        ''', (today, ip))
    db.commit()


def score_to_grade(score):
    """分数转等级"""
    if score >= 90:
        return 'A'
    elif score >= 80:
        return 'B'
    elif score >= 70:
        return 'C'
    elif score >= 60:
        return 'D'
    else:
        return 'F'


def score_color(score):
    """分数对应颜色"""
    if score >= 80:
        return '#10b981'  # success green
    elif score >= 60:
        return '#f59e0b'  # warning amber
    else:
        return '#ef4444'  # danger red


def calculate_score(issues, available_brain_ids=None):
    """
    加权扣分制计算综合得分
    
    扣分规则：
    - Blocker (critical): 每个 -10 分（不设上限）
    - High: 每个 -5 分（不设上限）
    - Medium: 每个 -3 分（最多扣 30 分）
    - Low: 每个 -0.5 分（最多扣 20 分）
    - score = max(0, 100 - 总扣分)
    
    参数:
        issues: 问题列表，每个问题需要有 severity 字段
        available_brain_ids: 可用的大脑 ID 列表（用于免费用户只计算 B1~B3）
    """
    if available_brain_ids:
        issues = [i for i in issues if str(i.get('brain_id', '')) in available_brain_ids]

    critical_count = sum(1 for i in issues if i.get('severity') == 'critical')
    high_count = sum(1 for i in issues if i.get('severity') == 'high')
    medium_count = sum(1 for i in issues if i.get('severity') == 'medium')
    low_count = sum(1 for i in issues if i.get('severity') == 'low')

    # 计算扣分
    deduction_critical = critical_count * 10       # 不设上限
    deduction_high = high_count * 5                # 不设上限
    deduction_medium = min(medium_count * 3, 30)   # 最多扣 30 分
    deduction_low = min(low_count * 0.5, 20)       # 最多扣 20 分

    total_deduction = deduction_critical + deduction_high + deduction_medium + deduction_low
    score = max(0, int(round(100 - total_deduction)))

    return score


def calculate_dimension_score(issues):
    """计算单个维度的得分（使用同一套扣分公式）"""
    return calculate_score(issues)


def severity_label(severity):
    """严重程度中文标签"""
    labels = {
        'critical': '严重',
        'high': '高危',
        'medium': '中等',
        'low': '轻微',
    }
    return labels.get(severity, severity)


